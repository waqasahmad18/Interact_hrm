# Copy to .env.local and fill values (Next.js reads .env.local in dev/production)

# DB_DRIVER=mysql (default) | mongo
# Staging 10.6 and production 10.98 both use mongo when cut over.
DB_DRIVER=mongo

# MySQL (only when DB_DRIVER=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=interact_hrm

# MongoDB (when DB_DRIVER=mongo — 10.6 staging / 10.98 production)
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=interact_hrm

# Built-in face verification (no external API)
# FACE_MATCH_MAX_DISTANCE: max euclidean distance for a match (lower = stricter,
#   range 0.35–0.52). 0.45 is security-first — rejects look-alikes.
# FACE_MIN_MATCH_PHOTOS: enrolled photos that must individually match (2 = a
#   second photo must corroborate; main guard against false accepts).
FACE_VERIFICATION_ENABLED=true
FACE_MATCH_MAX_DISTANCE=0.45
FACE_MIN_MATCH_PHOTOS=2

# Encrypt passwords stored for Remember me (change in production)
SAVED_LOGIN_SECRET=your-long-random-secret-here

# Auto presence / auto clock-out sweep
AUTO_PRESENCE_SWEEP_ENABLED=true
AUTO_PRESENCE_SWEEP_INTERVAL_MS=30000
