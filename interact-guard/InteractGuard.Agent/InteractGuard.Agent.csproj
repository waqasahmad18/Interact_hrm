<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>InteractGuard</RootNamespace>
    <AssemblyName>InteractGuard</AssemblyName>
    <Version>1.2.66</Version>
    <AssemblyVersion>1.2.66.0</AssemblyVersion>
    <FileVersion>1.2.66.0</FileVersion>
    <Description>Interact Guard — HRM-controlled presence, face verify, auto seat-absent tickets</Description>
    <ApplicationIcon>..\assets\InteractGuard.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.8" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\assets\InteractGuard.ico" Link="InteractGuard.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
